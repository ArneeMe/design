{
  "color": {
    "$type": "color",
    "grey": {
      "0": { "$value": "#0c0e10" },
      "1": { "$value": "#15181b" },
      "2": { "$value": "#1f2327" },
      "3": { "$value": "#2d3237" },
      "4": { "$value": "#474d53" },
      "5": { "$value": "#6a7077" },
      "6": { "$value": "#969ca2" },
      "7": { "$value": "#c1c6cb" },
      "8": { "$value": "#e2e5e8" },
      "9": { "$value": "#f5f6f7" },
      "white": { "$value": "#ffffff" }
    },
    "isbre": {
      "dark": { "$value": "#5fb0dc" },
      "light": { "$value": "#1b6390" }
    }
  },
  "theme": {
    "$type": "color",
    "dark": {
      "bg": { "$value": "{color.grey.0}" },
      "surface": { "$value": "{color.grey.1}" },
      "border": { "$value": "{color.grey.3}" },
      "text": { "$value": "{color.grey.8}" },
      "muted": { "$value": "{color.grey.6}" },
      "accent": { "$value": "{color.isbre.dark}" },
      "on-accent": { "$value": "{color.grey.0}" },
      "penguin-ink": { "$value": "{color.grey.0}" },
      "penguin-paper": { "$value": "{color.grey.9}" },
      "penguin-plate": { "$value": "{color.grey.3}" }
    },
    "light": {
      "bg": { "$value": "{color.grey.9}" },
      "surface": { "$value": "{color.grey.white}" },
      "border": { "$value": "{color.grey.7}" },
      "text": { "$value": "{color.grey.1}" },
      "muted": { "$value": "{color.grey.5}" },
      "accent": { "$value": "{color.isbre.light}" },
      "on-accent": { "$value": "{color.grey.white}" },
      "penguin-ink": { "$value": "{color.grey.0}" },
      "penguin-paper": { "$value": "{color.grey.9}" },
      "penguin-plate": { "$value": "{color.grey.9}" }
    }
  },
  "font": {
    "family": {
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "12px" },
      "base": { "$value": "15px" },
      "lg": { "$value": "22px" },
      "xl": { "$value": "32px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "2px" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "2px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  }
}
