{
  "color": {
    "$type": "color",
    "grey": {
      "0": { "$value": "#0e0e0d" },
      "1": { "$value": "#171716" },
      "2": { "$value": "#21211f" },
      "3": { "$value": "#2f2f2c" },
      "4": { "$value": "#4a4a46" },
      "5": { "$value": "#6a6a65" },
      "6": { "$value": "#9a9a94" },
      "7": { "$value": "#c6c6c0" },
      "8": { "$value": "#e4e4df" },
      "9": { "$value": "#f4f4f0" },
      "white": { "$value": "#ffffff" }
    },
    "ansi": {
      "black": { "$value": "{color.grey.2}" },
      "red": { "$value": "#d9644a" },
      "green": { "$value": "#8fae6a" },
      "yellow": { "$value": "{color.nebb.dark}" },
      "blue": { "$value": "#8a9fb0" },
      "magenta": { "$value": "#b7949f" },
      "cyan": { "$value": "#8eaba6" },
      "white": { "$value": "{color.grey.7}" },
      "bright-black": { "$value": "{color.grey.5}" },
      "bright-red": { "$value": "#e8806a" },
      "bright-green": { "$value": "#a8c483" },
      "bright-yellow": { "$value": "#f5b866" },
      "bright-blue": { "$value": "#a3b4c2" },
      "bright-magenta": { "$value": "#c9aab4" },
      "bright-cyan": { "$value": "#a6bfbb" },
      "bright-white": { "$value": "{color.grey.9}" }
    },
    "nebb": {
      "dark": { "$value": "#f0a040" },
      "light": { "$value": "#9a4a00" }
    }
  },
  "theme": {
    "$type": "color",
    "dark": {
      "bg": { "$value": "{color.grey.0}" },
      "surface": { "$value": "{color.grey.1}" },
      "border": { "$value": "{color.grey.3}" },
      "text": { "$value": "{color.grey.8}" },
      "muted": { "$value": "{color.grey.6}" },
      "accent": { "$value": "{color.nebb.dark}" },
      "on-accent": { "$value": "{color.grey.0}" },
      "penguin-ink": { "$value": "{color.grey.0}" },
      "penguin-paper": { "$value": "{color.grey.9}" },
      "penguin-plate": { "$value": "{color.grey.3}" }
    },
    "light": {
      "bg": { "$value": "{color.grey.9}" },
      "surface": { "$value": "{color.grey.white}" },
      "border": { "$value": "{color.grey.7}" },
      "text": { "$value": "{color.grey.1}" },
      "muted": { "$value": "{color.grey.5}" },
      "accent": { "$value": "{color.nebb.light}" },
      "on-accent": { "$value": "{color.grey.white}" },
      "penguin-ink": { "$value": "{color.grey.0}" },
      "penguin-paper": { "$value": "{color.grey.9}" },
      "penguin-plate": { "$value": "{color.grey.9}" }
    }
  },
  "font": {
    "family": {
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "12px" },
      "base": { "$value": "15px" },
      "lg": { "$value": "22px" },
      "xl": { "$value": "32px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "2px" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "2px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  }
}
